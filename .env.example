# Copy to .env (repository root or apps/api) and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL — one database for the whole platform
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qubators
DATABASE_POOL_MAX=10
# Used by the API test suite (it is wiped and migrated on every run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qubators_test

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in staging/production
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

# Browser origins allowed to call the API (comma separated) and the public web URL used in links/emails
CORS_ORIGIN=http://localhost:5180
APP_URL=http://localhost:5180

# Object storage: local | s3 (S3, Cloudflare R2, MinIO, any S3-compatible provider)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=100

# Trash retention background job (0 disables the in-process scheduler)
TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_MINUTES=60

# Email: console (development only) | smtp
MAIL_TRANSPORT=console
MAIL_FROM=Qub <no-reply@qub.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Encrypts email provider passwords/API keys entered in the admin console (32+ characters).
# If unset, a key is derived from JWT_SECRET (rotating JWT_SECRET then means re-entering them).
SETTINGS_ENCRYPTION_KEY=

# Requests per minute per IP (general) and for auth endpoints
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Optional: absolute path to apps/web/dist to serve the SPA from the API process
SERVE_WEB_DIST=
